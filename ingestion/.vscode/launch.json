{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: pytest (all ingestion tests)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Debug: pytest (current file)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Debug: wattstack-explore (verify only, no files written)",
      "type": "debugpy",
      "request": "launch",
      "module": "wattstack_ingestion.cli",
      "args": ["--verify-only"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Debug: wattstack-explore (7 days)",
      "type": "debugpy",
      "request": "launch",
      "module": "wattstack_ingestion.cli",
      "args": ["--days", "7"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "console": "integratedTerminal"
    }
  ]
}
